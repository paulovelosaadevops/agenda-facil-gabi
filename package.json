{
  "name": "agenda-facil",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --mode integration",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,realtime,storage-api,postgres-meta,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "functions:serve": "supabase functions serve --no-verify-jwt",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo/ui": "~57.0.25",
    "@supabase/supabase-js": "^2.118.0",
    "date-fns": "^4.4.0",
    "eslint-config-expo": "~57.0.2",
    "expo": "^57.0.30",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "supabase": "^2.121.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
