# Copie para supabase/functions/.env (local) ou use `supabase secrets set` (produção).
ANTHROPIC_API_KEY=
MESSAGING_PROVIDER=console
WHATSAPP_WEBHOOK_SECRET=troque-por-um-valor-aleatorio
CRON_SECRET=troque-por-um-valor-aleatorio

# Endereço do app (link de agendamento nas mensagens de manutenção)
APP_URL=https://agenda-facil.expo.app
# Só no Supabase local: endereço público das funções (links do calendário).
PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
