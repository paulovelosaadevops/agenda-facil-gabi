# Supabase (rode `npx supabase start` e copie os valores, ou use as chaves do projeto em supabase.com)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (usada no link de agendamento)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# IA (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# WhatsApp: "console" só registra no log. Novos provedores entram em src/lib/messaging/.
MESSAGING_PROVIDER=console
# Token exigido no webhook: POST /api/whatsapp/{slug}?token=...
WHATSAPP_WEBHOOK_SECRET=troque-por-um-valor-aleatorio

# Protege /api/cron/reminders (a Vercel Cron envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=troque-por-um-valor-aleatorio
