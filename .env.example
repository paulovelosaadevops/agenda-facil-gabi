# App (público: vai junto no app; quem protege os dados é a RLS do Supabase)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Endereço da versão web (EAS Hosting), usado no link de agendamento
EXPO_PUBLIC_APP_URL=https://agenda-facil.expo.app

# Segredos das Edge Functions ficam em supabase/functions/.env (veja .env.example lá)
# Modal web experimental do Expo Router: DESLIGADO (não mostra o cabeçalho com X/Salvar; ver memória)
EXPO_UNSTABLE_WEB_MODAL=0
